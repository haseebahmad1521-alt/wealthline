{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "uniwind-types.d.ts",
    "lib/database.types.ts",
    "lib/database.constants.ts",
    ".claude/**",
    "dist/**",
    "HANDOFF.md"
  ],
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "tw"]
  }
}
