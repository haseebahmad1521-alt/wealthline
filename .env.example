# Copy to .env.local (git-ignored). Public client config only — it ships in the app bundle.
# Never put a Supabase secret/service key or market-data keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dev only: send chat to `npm run chat:local` (your own Claude subscription) on this port instead of the chat Edge Function.
# EXPO_PUBLIC_CHAT_BRIDGE=8787
